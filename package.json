{
  "name": "vr-study-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "iwsdk dev restart --open --foreground",
    "dev:runtime": "vite",
    "dev:lan": "vite --host 0.0.0.0",
    "dev:usb": "npm run adb:reverse && IWSDK_HTTP=1 vite",
    "adb:reverse": "adb reverse tcp:8081 tcp:8081",
    "adb:devices": "adb devices -l",
    "dev:down": "iwsdk dev down",
    "dev:status": "iwsdk dev status",
    "reference:status": "iwsdk reference status",
    "reference:warmup": "iwsdk reference warmup",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "assets:sample-pdf": "python3 scripts/make-sample-pdf.py",
    "assets:ambience": "python3 scripts/make-ambience.py",
    "smoke": "node scripts/smoke-test.mjs",
    "test:unit": "node --experimental-strip-types --no-warnings scripts/unit-page-grab.mjs"
  },
  "dependencies": {
    "@iwsdk/core": "1.0.0-rc.2",
    "@pmndrs/uikit": "^1.0.74",
    "@pmndrs/uikit-horizon": "^1.0.74",
    "@pmndrs/uikit-lucide": "^1.0.74",
    "pdfjs-dist": "^6.3.289",
    "three": "npm:super-three@0.181.0"
  },
  "devDependencies": {
    "@iwsdk/cli": "1.0.0-rc.2",
    "@iwsdk/reference": "1.0.0-rc.2",
    "@iwsdk/vite-plugin-dev": "1.0.0-rc.2",
    "@meta-quest/metavr": "^1.3.2",
    "@types/three": "^0.181.0",
    "typescript": "^5.5.0",
    "vite": "^7.1.4"
  },
  "overrides": {
    "sharp": "0.35.4",
    "three": "npm:super-three@0.181.0"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
  }
}
